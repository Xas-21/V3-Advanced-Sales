# ======================================================
# Copy to .env and fill in. Never commit .env.
# ======================================================

# PostgreSQL — container + database name: as-postgres
DATABASE_URL=postgresql://as_owner:CHANGE_ME@as-postgres:5432/as-postgres
DB_PASSWORD=CHANGE_ME

# Session signing secret (32+ random characters)
SESSION_SECRET=change-this-to-a-long-random-string

# CORS allowed origins (comma separated)
# Local feature work:
CORS_ORIGINS=http://localhost:5173,http://localhost
# Production example:
# CORS_ORIGINS=https://app.as-saas.com

USE_FILE_STORAGE=false

# Health payload version override (optional)
# APP_VERSION=

# Upload storage path (prod compose default)
# UPLOADS_DIR=/data/uploads

# Contact form recipient (optional)
# CONTACT_TO_EMAIL=

# Production builds only (usually leave empty — nginx proxies /api to as-backend)
VITE_API_BASE_URL=
