# ======================================================
# Local dev .env — copy this file to .env and fill in
# ======================================================

# PostgreSQL connection (as-postgres-V2 is the container name)
DATABASE_URL=postgresql://neondb_owner:***@as-postgres-V2:5432/neondb

# Session signing secret (32+ random characters)
SESSION_SECRET=your-ran...ea2

# CORS allowed origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost

# Keep false (legacy JSON fallback, not needed)
USE_FILE_STORAGE=false

# Database password (matches the one in DATABASE_URL)
DB_PASSWORD=postgres

# Only needed for production builds — leave empty for dev
VITE_API_BASE_URL=
