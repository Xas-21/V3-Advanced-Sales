# ======================================================
# Copy to .env and fill in. Never commit .env.
# ======================================================

# PostgreSQL — production reuses the existing V3 database (neondb_owner/neondb).
# The prod stack mounts the EXISTING external volume as-postgres-v3-data.
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@as-postgres:5432/neondb
# Password for the V3 Postgres (must match the password baked into the volume).
V3_DB_PASSWORD=CHANGE_ME
# Legacy dev DB / V2 reference container password (docker-compose.yml only).
DB_PASSWORD=CHANGE_ME

# Session signing secret (32+ random characters)
SESSION_SECRET=change-this-to-a-long-random-string

# CORS allowed origins (comma separated)
# Local feature work:
CORS_ORIGINS=http://localhost:5173,http://localhost
# Production example:
# CORS_ORIGINS=https://<your-domain>

USE_FILE_STORAGE=false

# --- Production (docker-compose.prod.yml) ---
# Public domain Traefik routes to as-frontend:
# APP_DOMAIN=app.example.com
# Traefik ACME cert resolver name (defaults to "letsencrypt"):
# TRAEFIK_CERTRESOLVER=letsencrypt

# Health payload version override (optional)
# APP_VERSION=

# Upload storage path (prod compose default)
# UPLOADS_DIR=/data/uploads

# Contact form recipient (optional)
# CONTACT_TO_EMAIL=

# Production builds only — leave EMPTY (same-origin; nginx proxies /api and /ws)
VITE_API_BASE_URL=
