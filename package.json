{
  "name": "advanced-sales-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:api:win": "cd backend && .\\venv\\Scripts\\python.exe -m uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "db:import:postgres": "cd backend && python scripts/import_json_to_postgres.py",
    "db:import:postgres:win": "cd backend && .\\venv\\Scripts\\python.exe scripts\\import_json_to_postgres.py",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 2319",
    "preview": "vite preview",
    "testsprite:frontend": "npm run build && vite preview",
    "test:backend": "cd backend && python -m pytest tests -v",
    "test:backend:win": "cd backend && .\\venv\\Scripts\\pytest.exe tests -v",
    "test:frontend": "vitest run",
    "test:request-detail-layout": "node scripts/verify-request-detail-agenda-source.mjs",
    "test": "npm run test:frontend && npm run test:request-detail-layout && npm run test:backend"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@gsap/react": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.0.0",
    "docxtemplater": "^3.68.4",
    "dompurify": "^3.4.12",
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.300.0",
    "mammoth": "^1.12.0",
    "pizzip": "^3.2.0",
    "radix-ui": "^1.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.9",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/recharts": "^1.8.29",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
