FROM python:3.13-slim

WORKDIR /app

# Install dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ .

# Pin uid 1000. A named volume created on an earlier root boot stays root-owned;
# as-uploads-init in compose chowns /data/uploads to this user before the API starts.
RUN addgroup --gid 1000 appuser \
    && adduser --disabled-password --gecos "" --uid 1000 --ingroup appuser appuser \
    && mkdir -p /data/uploads \
    && chown -R appuser:appuser /app /data/uploads

USER appuser

# Expose backend port
EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
