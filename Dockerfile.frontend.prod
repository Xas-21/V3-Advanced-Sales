FROM node:22-slim

WORKDIR /app

# Install dependencies (leverage layer cache)
COPY package.json package-lock.json ./
RUN npm ci

# Build the production bundle
COPY . .
RUN npm run build

# Serve the static build. `vite preview` is fine for a single-node deployment
# behind Traefik TLS; it also respects VITE_API_BASE_URL at build time (same-origin /api).
EXPOSE 5173
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5173"]
